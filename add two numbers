#include <stdio.h>
#include <stdlib.h>

/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     struct ListNode *next;
 * };
 * 
 * Note: The struct definition above is already provided by the system.
 * Do not uncomment or rewrite it in your solution.
 */

// Helper function to create a new node safely
struct ListNode* createNode(int val) {
    struct ListNode* newNode = (struct ListNode*)malloc(sizeof(struct ListNode));
    newNode->val = val;
    newNode->next = NULL;
    return newNode;
}

struct ListNode* addTwoNumbers(struct ListNode* l1, struct ListNode* l2) {
    struct ListNode dummy; 
    dummy.next = NULL;
    struct ListNode* current = &dummy;
    int carry = 0;

    // Loop until both lists are empty and no carry remains
    while (l1 != NULL || l2 != NULL || carry != 0) {
        int val1 = (l1 != NULL) ? l1->val : 0;
        int val2 = (l2 != NULL) ? l2->val : 0; 

        // Calculate sum and new carry
        int sum = val1 + val2 + carry;
        carry = sum / 10;

        // Create new node with the remainder
        current->next = createNode(sum % 10);
        current = current->next;

        // Advance input pointers if nodes exist
        if (l1 != NULL) l1 = l1->next;
        if (l2 != NULL) l2 = l2->next;
    }

    return dummy.next;
}
