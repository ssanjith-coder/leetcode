#include <stdlib.h>
#include <string.h>

typedef struct {
    int value;
    const char *symbol;
} RomanMap;

char* intToRoman(int num) {
    RomanMap map[] = {
        {1000, "M"}, {900, "CM"}, {500, "D"}, {400, "CD"},
        {100, "C"},  {90, "XC"},  {50, "L"},  {40, "XL"},
        {10, "X"},   {9, "IX"},   {5, "V"},   {4, "IV"},
        {1, "I"}
    };
    
    // Allocate space for the result string. 
    // The longest Roman numeral under 4000 is 15 characters long (e.g., 3888 = MMMDCCCLXXXVIII).
    char* result = (char*)malloc(20 * sizeof(char));
    result[0] = '\0'; // Initialize empty string
    
    int map_size = sizeof(map) / sizeof(map[0]);
    
    for (int i = 0; i < map_size; i++) {
        while (num >= map[i].value) {
            strcat(result, map[i].symbol);
            num -= map[i].value;
        }
    }
    
    return result;
}
