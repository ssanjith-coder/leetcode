#include <stdio.h>
#include <stdbool.h>
#include <string.h>

bool isMatch(char* s, char* p) {
    int s_len = strlen(s);
    int p_len = strlen(p);
    
    // dp[i][j] will be true if s[0..i-1] matches p[0..j-1]
    bool dp[s_len + 1][p_len + 1];
    memset(dp, 0, sizeof(dp));
    
    // Base case: empty string matches empty pattern
    dp[0][0] = true;
    
    // Handle patterns like a*, a*b*, or .* which can match an empty string
    for (int j = 2; j <= p_len; j++) {
        if (p[j - 1] == '*') {
            dp[0][j] = dp[0][j - 2];
        }
    }
    
    // Fill the DP table
    for (int i = 1; i <= s_len; i++) {
        for (int j = 1; j <= p_len; j++) {
            if (p[j - 1] == '.' || p[j - 1] == s[i - 1]) {
                // Current characters match
                dp[i][j] = dp[i - 1][j - 1];
            } else if (p[j - 1] == '*') {
                // Two cases for '*' wildcard:
                // Case 1: Match 0 instances of the preceding character
                dp[i][j] = dp[i][j - 2];
                
                // Case 2: Match 1 or more instances of the preceding character
                if (p[j - 2] == '.' || p[j - 2] == s[i - 1]) {
                    dp[i][j] = dp[i][j] || dp[i - 1][j];
                }
            }
        }
    }
    
    return dp[s_len][p_len];
}
