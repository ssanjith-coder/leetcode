#include <limits.h>

int reverse(int x) {
    int reversed = 0;

    while (x != 0) {
        int pop = x % 10;
        x /= 10;

        // Positive overflow check: 
        // 1. If reversed is greater than INT_MAX / 10, multiplying by 10 will overflow.
        // 2. If reversed equals INT_MAX / 10, adding a digit greater than 7 will overflow.
        if (reversed > INT_MAX / 10 || (reversed == INT_MAX / 10 && pop > 7)) {
            return 0;
        }

        // Negative overflow check:
        // 1. If reversed is less than INT_MIN / 10, multiplying by 10 will overflow.
        // 2. If reversed equals INT_MIN / 10, adding a digit less than -8 will overflow.
        if (reversed < INT_MIN / 10 || (reversed == INT_MIN / 10 && pop < -8)) {
            return 0;
        }

        reversed = reversed * 10 + pop;
    }

    return reversed;
}
